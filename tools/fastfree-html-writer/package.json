{
  "name": "fastfree-html-writer",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "MCP server that renders structured content into styled RTL HTML documentation pages",
  "bin": {
    "fastfree-html-writer": "./build/index.js"
  },
  "scripts": {
    "build": "tsc && chmod 755 build/index.js",
    "typecheck": "tsc --noEmit",
    "start": "node build/index.js",
    "serve": "node build/serve.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "typescript": "^5.9.3"
  }
}
