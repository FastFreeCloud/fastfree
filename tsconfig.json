{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "preserve",
    "jsxImportSource": "vue",
    "paths": {
      "@fastfree/lowcode": ["./packages/fastfree_lowcode/src/runtime/index.ts"],
      "@fastfree/lowcode/*": ["./packages/fastfree_lowcode/src/runtime/*"],
      "fastfree-auth": ["./packages/fastfree_auth/src/index.ts"],
      "fastfree-auth/*": ["./packages/fastfree_auth/src/*"],
      "fastfree-lowcode": ["./packages/fastfree_lowcode/src/runtime/index.ts"],
      "fastfree-lowcode/*": ["./packages/fastfree_lowcode/src/runtime/*"],
      "quasar-app-extension-fastfree-lowcode": ["./packages/fastfree_lowcode/src/runtime/index.ts"],
      "quasar-app-extension-fastfree-lowcode/runtime": [
        "./packages/fastfree_lowcode/src/runtime/index.ts"
      ],
      "quasar-app-extension-fastfree-lowcode/src/runtime": [
        "./packages/fastfree_lowcode/src/runtime/index.ts"
      ],
      "quasar-app-extension-fastfree-lowcode/src/runtime/index": [
        "./packages/fastfree_lowcode/src/runtime/index.ts"
      ],
      "quasar-app-extension-fastfree-lowcode/src/runtime/*": [
        "./packages/fastfree_lowcode/src/runtime/*"
      ],
      "quasar-app-extension-fastfree-lowcode/*": [
        "./packages/fastfree_lowcode/src/runtime/*"
      ]
    }
  },
  "include": [
    "shims.d.ts",
    "packages/*/src/**/*.ts",
    "packages/*/src/**/*.vue"
  ],
  "exclude": ["node_modules", "packages/*/.quasar", "packages/*/playground"]
}
