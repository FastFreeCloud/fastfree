!apps/fastfree_panel/dist/spa/**

# Logs
*.log
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# Environment files
.env
.env.local
.env.*.local

# Google service account keys (NEVER commit — live credentials)
fastfree-508417-8f88d017a77c.json
*-service-account*.json
*-key.json

# Play Console automation session (NEVER commit — live Google cookies/profile)
.auth/
*.auth.json

# OS files
.DS_Store
Thumbs.db
*.swp
*.swo
*~

# IDE files
.vscode/
.idea/
*.sublime-project
*.sublime-workspace

# Rust / Tauri
**/src-tauri/target/
**/src-tauri/gen/

# Nix
result
result-*

# Quasar
.quasar/
quasar.config.*.temporary.compiled*

# Temp files
tmp/
temp/
*.tmp
*.temp

# Coverage
coverage/
.nyc_output/

# Cache
.cache/
.eslintcache
.stylelintcache

# Frappe/Bench
