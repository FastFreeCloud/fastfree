# quser backend — operator variables (COPY to .env, never commit real values)
# cp .env.example .env && chmod 600 .env

# Hospital site (HoloolHIS) — backend only, never in frontend/git
HIS_URL=https://manfalout.docuin.com
HIS_HOSPITAL=manfalout
HIS_USERNAME=
HIS_PASSWORD=

# App login (this tool's own users, not the hospital)
QUSER_USERNAME=admin
# argon2 hash of the app password (generate once, paste here)
QUSER_PASSWORD_HASH=
# random 32+ bytes: python -c "import secrets; print(secrets.token_urlsafe(32))"
QUSER_JWT_SECRET=change-me-to-random-string
