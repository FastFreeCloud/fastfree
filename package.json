{
  "name": "fastfree",
  "version": "1.0.0",
  "description": "FastFree ERP monorepo — 3 core apps (installer, backend, website) + 10 modular packages (accounting, auth, crm, hr, inventory, lowcode, os, panel, purchase, sales)",
  "main": "index.js",
  "scripts": {
    "installer:dev": "bun --cwd apps/fastfree_installer run tauri dev",
    "installer:web": "bun --cwd apps/fastfree_installer run dev",
    "panel:dev": "bun --cwd packages/fastfree_panel run dev",
    "panel:build": "bun --cwd packages/fastfree_panel run build",
    "panel:backend:dev": "bun --cwd packages/fastfree_panel/backend run dev",
    "test:unit": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "^11.11.0",
      "onFail": "ignore"
    }
  },
  "type": "module",
  "devDependencies": {
    "@vitest/coverage-v8": "5.1.0",
    "c8": "12.0.0",
    "eslint": "^10.9.1",
    "vitest": "^5.1.0"
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@fontsource/ibm-plex-sans": "5.3.0",
    "@fontsource/ibm-plex-sans-arabic": "5.3.0"
  }
}
