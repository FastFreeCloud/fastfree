    "1:1": {
      "width": 1080,
      "height": 1080,
      "label": "Square",
      "platforms": [
        "Facebook feed",
        "Instagram feed",
        "LinkedIn feed",
        "Instagram carousel"
      ],
      "note": "Safe on every platform. Slightly cropped in the 3:4 profile grid."
    },
    "1.91:1": {
      "width": 1200,
      "height": 630,
      "label": "Link preview",
      "platforms": [
        "Facebook link",
        "LinkedIn shared link",
        "Open Graph",
        "X"
      ],
      "note": "Use for link previews. Small in a feed; the Instagram equivalent is 1080x566."
    },
    "9:16": {
      "width": 1080,
      "height": 1920,
      "label": "Story",
      "platforms": [
        "Instagram story",
        "Facebook story",
        "Reels cover"
      ],
      "note": "Keep text clear of the top and bottom 250 px, where the UI overlays sit."
    },
    "16:9": {
      "width": 1920,
      "height": 1080,
      "label": "Landscape",
      "platforms": [
        "YouTube",
        "X",
        "Presentation"
      ],
      "note": "Wide screens. Not an accepted Instagram feed ratio."
    },
    "3:4": {
      "width": 1080,
      "height": 1440,
      "label": "Tall feed",
      "platforms": [
        "Facebook feed",
        "Instagram feed"
      ],
      "note": "Fills the 3:4 profile grid with no crop."
    }
  },
