    "4:5": {
      "width": 1080,
      "height": 1350,
      "label": "Portrait feed",
      "platforms": [
        "Facebook feed",
        "Instagram feed",
        "LinkedIn feed",
        "Threads"
      ],
      "note": "Best reach in 2026. Takes the most screen space in a mobile feed."
