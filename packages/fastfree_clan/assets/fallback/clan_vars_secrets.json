{
  "type": "scaffold",
  "backgroundColor": "#0B1220",
  "appBar": {
    "type": "appBar",
    "title": { "type": "text", "data": "Clan Vars & Secrets" },
    "backgroundColor": "#111827",
    "foregroundColor": "#F8FAFC"
  },
  "body": {
    "type": "singleChildScrollView",
    "child": {
      "type": "padding",
      "padding": { "all": 16 },
      "child": {
        "type": "column",
        "crossAxisAlignment": "stretch",
        "children": [
          {
            "type": "container",
            "padding": { "all": 16 },
            "decoration": { "color": "#111827", "borderRadius": 12 },
            "child": {
              "type": "column",
              "crossAxisAlignment": "start",
              "children": [
                { "type": "text", "data": "Vars Metadata (No Secret Values)", "style": { "fontSize": 20, "fontWeight": "bold", "color": "#F8FAFC" } },
                { "type": "sizedBox", "height": 6 },
                { "type": "text", "data": "Metadata is fetched from /api/v1/clan/vars. Secret values are never stored or displayed.", "style": { "fontSize": 13, "color": "#94A3B8" } }
              ]
            }
          },
          { "type": "sizedBox", "height": 12 },
          {
            "type": "container",
            "padding": { "all": 14 },
            "decoration": { "color": "#451A03", "borderRadius": 12 },
            "child": {
              "type": "row",
              "children": [
                { "type": "icon", "icon": "lock", "color": "#FBBF24" },
                { "type": "sizedBox", "width": 10 },
                { "type": "expanded", "child": { "type": "text", "data": "Security: is_secret vars show metadata only (scope, scopeId, path, name). Values are omitted by design.", "style": { "fontSize": 13, "color": "#FDE68A" } } }
              ]
            }
          },
          { "type": "sizedBox", "height": 12 },
          {
            "type": "container",
            "padding": { "all": 14 },
            "decoration": { "color": "#111827", "borderRadius": 12 },
            "child": {
              "type": "column",
              "crossAxisAlignment": "start",
              "children": [
                { "type": "text", "data": "Example metadata entries", "style": { "fontSize": 16, "fontWeight": "bold", "color": "#F8FAFC" } },
                { "type": "sizedBox", "height": 8 },
                { "type": "listTile", "leading": { "type": "icon", "icon": "vpn_key", "color": "#F59E0B" }, "title": { "type": "text", "data": "wireguard/private_key", "style": { "color": "#F8FAFC", "fontSize": 14 } }, "subtitle": { "type": "text", "data": "scope: machine • scopeId: client1 • isSecret: true • value: (hidden)", "style": { "color": "#94A3B8", "fontSize": 12 } } },
                { "type": "divider", "color": "#1F2937" },
                { "type": "listTile", "leading": { "type": "icon", "icon": "description", "color": "#38BDF8" }, "title": { "type": "text", "data": "service/endpoint", "style": { "color": "#F8FAFC", "fontSize": 14 } }, "subtitle": { "type": "text", "data": "scope: shared • isSecret: false • metadata only view", "style": { "color": "#94A3B8", "fontSize": 12 } } },
                { "type": "sizedBox", "height": 6 },
                { "type": "text", "data": "No vars are seeded by default. Create/list metadata via API; this screen renders metadata safely.", "style": { "fontSize": 12, "color": "#64748B" } }
              ]
            }
          }
        ]
      }
    }
  }
}
