{
  "type": "scaffold",
  "backgroundColor": "#0B1220",
  "appBar": {
    "type": "appBar",
    "title": { "type": "text", "data": "Clan Provisioning & Deploy" },
    "backgroundColor": "#111827",
    "foregroundColor": "#F8FAFC"
  },
  "body": {
    "type": "singleChildScrollView",
    "child": {
      "type": "padding",
      "padding": { "all": 16 },
      "child": {
        "type": "column",
        "crossAxisAlignment": "stretch",
        "children": [
          {
            "type": "container",
            "padding": { "all": 16 },
            "decoration": { "color": "#111827", "borderRadius": 12 },
            "child": {
              "type": "column",
              "crossAxisAlignment": "start",
              "children": [
                { "type": "text", "data": "Provisioning & Deployment", "style": { "fontSize": 20, "fontWeight": "bold", "color": "#F8FAFC" } },
                { "type": "sizedBox", "height": 6 },
                { "type": "text", "data": "Track machine readiness and trigger deploy actions via clan APIs (status view).", "style": { "fontSize": 13, "color": "#94A3B8" } }
              ]
            }
          },
          { "type": "sizedBox", "height": 12 },
          {
            "type": "container",
            "padding": { "all": 14 },
            "decoration": { "color": "#111827", "borderRadius": 12 },
            "child": {
              "type": "column",
              "crossAxisAlignment": "start",
              "children": [
                { "type": "text", "data": "Actions", "style": { "fontSize": 16, "fontWeight": "bold", "color": "#F8FAFC" } },
                { "type": "sizedBox", "height": 10 },
                { "type": "elevatedButton", "child": { "type": "text", "data": "Refresh Inventory" } },
                { "type": "sizedBox", "height": 8 },
                { "type": "elevatedButton", "child": { "type": "text", "data": "Plan Deploy (all nodes)" } },
                { "type": "sizedBox", "height": 8 },
                { "type": "elevatedButton", "child": { "type": "text", "data": "Apply / Deploy (selected)" } },
                { "type": "sizedBox", "height": 8 },
                { "type": "text", "data": "Buttons are SDUI actions; wire to your orchestrator endpoints as they become available.", "style": { "fontSize": 12, "color": "#64748B" } }
              ]
            }
          },
          { "type": "sizedBox", "height": 12 },
          {
            "type": "container",
            "padding": { "all": 14 },
            "decoration": { "color": "#111827", "borderRadius": 12 },
            "child": {
              "type": "column",
              "crossAxisAlignment": "start",
              "children": [
                { "type": "text", "data": "Deployment status", "style": { "fontSize": 16, "fontWeight": "bold", "color": "#F8FAFC" } },
                { "type": "sizedBox", "height": 8 },
                { "type": "listTile", "leading": { "type": "icon", "icon": "check_circle", "color": "#34D399" }, "title": { "type": "text", "data": "client1", "style": { "color": "#F8FAFC" } }, "subtitle": { "type": "text", "data": "active • last known: ready (fallback view)", "style": { "color": "#94A3B8", "fontSize": 12 } } },
                { "type": "divider", "color": "#1F2937" },
                { "type": "listTile", "leading": { "type": "icon", "icon": "check_circle", "color": "#34D399" }, "title": { "type": "text", "data": "client2", "style": { "color": "#F8FAFC" } }, "subtitle": { "type": "text", "data": "active • last known: ready (fallback view)", "style": { "color": "#94A3B8", "fontSize": 12 } } },
                { "type": "sizedBox", "height": 4 },
                { "type": "text", "data": "Use /api/v1/clan/machines and realtime events to reflect live deploy/provisioning state.", "style": { "fontSize": 12, "color": "#64748B" } }
              ]
            }
          }
        ]
      }
    }
  }
}
