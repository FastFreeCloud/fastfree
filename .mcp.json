{
  "mcpServers": {
    "ai-rulez": {
      "args": [
        "-y",
        "ai-rulez@latest",
        "mcp",
        "--allow-any-dir",
        "--serve-skills"
      ],
      "command": "npx",
      "type": "stdio"
    },
    "jcodemunch": {
      "command": "uvx",
      "args": [
        "jcodemunch-mcp==1.108.397",
        "serve"
      ],
      "type": "stdio"
    },
    "repomap": {
      "command": "npx",
      "args": [
        "-y",
        "@sylphx/repomap@1.8.0",
        "mcp"
      ],
      "type": "stdio"
    },
    "tauri": {
      "command": "npx",
      "args": [
        "-y",
        "@hypothesi/tauri-mcp-server@0.13.2"
      ],
      "type": "stdio"
    }
  }
}
