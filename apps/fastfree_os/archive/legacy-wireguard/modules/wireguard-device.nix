# FastFree OS — WireGuard Device (External Peer) Module
#
# ── Purpose ──────────────────────────────────────────────────────────────────
# Declares a single external WireGuard device (phone, laptop, server, IoT) that
# connects to a Clan device-network instance (clientN-devices).
# The device is NOT a Clan machine; its peer entry is appended to the controller'"'"'s
# official `services.official.wireguard` instance via the mergeable
# `networking.wireguard.interfaces.<instance>.peers` list.
#
# ── Naming convention (OFFICIAL Clan) ────────────────────────────────────────
# Instance:        client${clientNum}-devices        (port 51821)
# Device name:     client${clientNum}_d_${deviceNum}  (e.g. client7_d_3)
# Peer hostname:   client${clientNum}_d_${deviceNum}.wireguard
#
# ── Topology ─────────────────────────────────────────────────────────────────
# Controller (client2) holds the listen port (51821) for ALL device networks.
# Each device network (clientN-devices) is a /24 subnet: 10.0.N.0/24.
# The device dials the controller at fastfree.cloud:51821.
# The controller'"'"'s peer entry for the device carries AllowedIPs = device /96
# (matching the official service'"'"'s /96 per-peer allocation).
#
# ── Address allocation ───────────────────────────────────────────────────────
# Device address inside the clientN-devices subnet is derived exactly like the
# official service: SHA256(deviceName) -> last 64 bits of IPv6 /56, or the
# `wireguard-network-${instance}-${deviceName}` vars generator suffix.
# This ensures external and internal peers are indistinguishable on the wire.
#
# ── Keys ─────────────────────────────────────────────────────────────────────
# Private key: generated ON THE DEVICE, never leaves it. Only the public key
# is declared here. The controller learns the public key from this module.
# The controller'"'"'s own keypair comes from the official service'"'"'s
# `wireguard-keys-${instance}-${controllerClient}` generator (sops-decrypted).
#
# ── Usage ────────────────────────────────────────────────────────────────────
# On the controller (client2) in configuration.nix:
#
#   wireguard.device = {
#     enable = true;
#     name = "phone-ali";
#     client = "client7";
#     type = "mobile";
#     publicKey = "base64pubkey...";
#     # persistentKeepalive = 25;  # default
#   };
#
# Then: `clan machines update` / `nixos-rebuild switch`.
{ config, lib, ... }:

let
  cfg = config.wireguard.device;

  # ── Constants ──────────────────────────────────────────────────────────────
  controllerClient = "client2";
  controllerEndpoint = "fastfree.cloud";
  devicePort = 51821;
  domain = "wireguard";

  # ── Derived values ─────────────────────────────────────────────────────────
  # Instance name follows Clan convention: client${clientNum}-devices
  instanceName = "client${cfg.client}-devices";

  # Device peer name: client${clientNum}_d_${deviceNum}
  # We extract deviceNum from the name if it matches the pattern, otherwise
  # we hash the name to get a stable number.
  deviceNum = lib.optionalString (lib.hasPrefix "d_" cfg.name)
    (builtins.substring 2 (builtins.stringLength cfg.name - 2) cfg.name);
  peerName = "client${builtins.substring 6 (builtins.stringLength cfg.client - 7) cfg.client}_d_${deviceNum or (builtins.toString (lib.strHash cfg.name))}";

  # Device network subnet: 10.0.N.0/24 where N = clientNum
  clientNum = builtins.substring 6 (builtins.stringLength cfg.client - 7) cfg.client;
  deviceSubnet = "10.0.${clientNum}.0/24";

  # Controller address in this device network: 10.0.N.1
  controllerAddr = "10.0.${clientNum}.1";

  # ── Vars generator names ───────────────────────────────────────────────────
  # Keys generator for this instance + controller (holds controller'"'"'s keypair)
  controllerKeysGenerator = "wireguard-keys-${instanceName}-${controllerClient}";
  # Keys generator for this instance + device'"'"'s client (holds device'"'"'s keypair if generated by clan)
  deviceKeysGenerator = "wireguard-keys-${instanceName}-${cfg.client}";
  # Network generator for this instance (holds prefix/suffix for address allocation)
  networkGenerator = "wireguard-network-${instanceName}";

  # ── Check if we'"'"'re on the controller ───────────────────────────────────────
  isController = config.clan.core.name == controllerClient;

  # ── Controller'"'"'s public key (from official service'"'"'s vars generator) ───────
  controllerPublicKey = config.clan.core.vars.generators.${controllerKeysGenerator}.files.publickey.value;

  # ── Device address ─────────────────────────────────────────────────────────
  # Prefer the official vars generator suffix if it exists (Clan-managed device).
  # Otherwise compute via SHA256 of peerName (matching official ipv6_allocator.py).
  deviceAddress = lib.optionalString (cfg.enable && isController) (
    if builtins.hasAttr "wireguard-network-${instanceName}-${peerName}" config.clan.core.vars.generators then
      # Clan-managed: suffix from vars generator
      "fd28:387a:3f:45${config.clan.core.vars.generators.\"wireguard-network-${instanceName}-${peerName}\".files.suffix.value}"
    else
      # Self-managed: derive from SHA256(peerName) like official service
      let
        # This mirrors the logic in clan-core'"'"'s ipv6_allocator.py
        # sha256(name) -> take last 16 hex chars -> format as IPv6 interface ID
        hash = lib.hashString "sha256" peerName;
        ifaceId = builtins.substring (builtins.stringLength hash - 16) 16 hash;
        # Format: fd28:387a:3f:45XX:XXXX:XXXX:XXXX
        parts = lib.map (n: builtins.substring (n * 4) 4 ifaceId) (lib.range 0 4);
      in "fd28:387a:3f:45${builtins.concatStringsSep ":" parts}"
  );

  # ── Peer config for the controller'"'"'s wireguard interface ───────────────────
  peerConfig = {
    publicKey = cfg.publicKey;
    allowedIPs = [ "${deviceAddress}/96" ];
    persistentKeepalive = cfg.persistentKeepalive;
  };

  # ── Client configuration file (for the device to import) ───────────────────
  # The device'"'"'s private key is NOT included — the user pastes it in before import.
  clientConf = ''
    # FastFree mesh — device: ${peerName}
    # Generated by modules/wireguard-device.nix. Paste the device'"'"'s private
    # key where marked, then import this file into the WireGuard app.
    [Interface]
    PrivateKey = <PASTE THE DEVICE PRIVATE KEY HERE>
    Address = ${deviceAddress}/56

    [Peer]
    PublicKey = ${controllerPublicKey}
    Endpoint = ${controllerEndpoint}:${toString devicePort}
    AllowedIPs = fd28:387a:3f:4500::/56
    PersistentKeepalive = ${toString cfg.persistentKeepalive}
  '';

in
{
  options.wireguard.device = {
    enable = lib.mkEnableOption "WireGuard external device (phone, laptop, server, IoT)";

    name = lib.mkOption {
      type = lib.types.str;
      description = ''
        Device identifier, e.g. "phone-ali", "laptop-work", "server-backup".
        Used to derive the peer name (clientN_d_X) and address.
      '';
    };

    client = lib.mkOption {
      type = lib.types.str;
      description = ''
        The client this device belongs to (e.g. "client7").
        Determines which device network instance (clientN-devices) it joins.
      '';
    };

    type = lib.mkOption {
      type = lib.types.enum [ "mobile" "laptop" "server" "iot" ];
      default = "mobile";
      description = "Device type for documentation and firewall rules.";
    };

    publicKey = lib.mkOption {
      type = lib.types.str;
      description = ''
        WireGuard public key of the device. Generate the keypair ON THE DEVICE
        (`wg genkey | wg pubkey`) and copy only the public key here.
        The private key NEVER leaves the device.
      '';
    };

    persistentKeepalive = lib.mkOption {
      type = lib.types.int;
      default = 25;
      description = ''
        Seconds between keepalive packets. Matches the value the official
        service uses for its own peers, and keeps the NAT mapping alive on
        mobile networks.
      '';
    };
  };

  config = lib.mkIf (cfg.enable && isController) {
    # Append this device as a peer to the official wireguard instance.
    # The official service creates `networking.wireguard.interfaces.<instance>`
    # and its `peers` option is a list that merges by concatenation.
    networking.wireguard.interfaces.${instanceName}.peers = [ peerConfig ];

    # Hostname resolution for the device within the mesh.
    # The official service writes the same option for Clan peers; `types.lines`
    # merges by concatenation, so both sets end up in /etc/hosts.
    networking.extraHosts = "${deviceAddress} ${peerName}.${domain}";

    # Ready-to-import client configuration at /etc/fastfree/wireguard-device/<peerName>.conf
    # The device'"'"'s private key is NOT in it — the user pastes it in before importing.
    environment.etc."fastfree/wireguard-device/${peerName}.conf" = {
      text = clientConf;
      mode = "0644";
    };
  };
}
