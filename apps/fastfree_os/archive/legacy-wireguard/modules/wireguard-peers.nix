# External (non-Clan) peers on the official Clan WireGuard mesh.
#
# ── Naming convention ──────────────────────────────────────────────────────
# A peer is named after the CLIENT it belongs to plus the device number:
#
#     client1_d_1   → device 1 of client1
#     client1_d_2   → device 2 of client1
#     client3_d_1   → device 1 of client3
#
# The name is the single source of truth: it derives the peer's address
# inside the mesh and its hostname, so the same device is always
# recognisable in `wg show`, in /etc/hosts and in the generated .conf file.
#
# ── Why this module exists ────────────────────────────────────────────────
# The official service (`services/official/wireguard`, clan-core) manages peers
# that are Clan machines: every peer needs a role, a vars generator and a
# NixOS configuration. A phone or a Windows laptop is not a Clan machine, so
# it cannot be given a role.
#
# It can still join the mesh, because the mesh is a plain NixOS WireGuard
# interface — `networking.wireguard.interfaces.<instance>` — and its `peers`
# option is a *list of submodules*, which NixOS merges by CONCATENATION
# (`types.listOf` → `merge = x ++ y`). So a peer added from this module is
# APPENDED to the official peer list; it never replaces it.
#
# ── Why an external peer can still reach every Clan peer ──────────────────
# The service gives each Clan peer this route on its side:
#
#     allowedIPs = [ "<controllerPrefix>::/56" ]
#
# i.e. the peer routes the controller's ENTIRE /56 subnet through the
# controller. Any address inside that /56 is therefore reachable through the
# controller — including an external peer's address.
#
# The controller, in turn, needs to know where to send the replies, so its
# peer entry for the device carries that device's /96. The service does the
# same for its own peers: `allowedIPs = "<prefix>:<suffix>/96"`.
#
# Result: a device with an address inside the controller's /56 reaches every
# peer, and every peer reaches it back — through the controller, with no new
# public exposure and no second mesh.
{ config, lib, ... }:
let
  cfg = config.fastfree.wireguardPeers;
  # The Clan service instance name. It is also the WireGuard interface name
  # (the service uses `networking.wireguard.interfaces.<instance>`), and it
  # is what the vars groups are named after — so it must stay in sync with
  # the `wireguard` instance in clan.nix.
  instance = cfg.instance;
  domain = cfg.domain;

  networkGenerator = "wireguard-network-${instance}";
  keysGenerator = "wireguard-keys-${instance}";

  # Only the controller has a "prefix" file; a peer gets a "suffix" instead.
  # Checking for it keeps the module inert on a peer machine instead of
  # failing the evaluation.
  isController =
    cfg.enable
    && builtins.hasAttr networkGenerator config.clan.core.vars.generators
    && (
      config.clan.core.vars.generators.${networkGenerator}.files ? prefix
    );

  # Public values the official service already generated for this controller.
  # Both are non-secret vars, so they are readable at evaluation time.
  controllerPrefix =
    config.clan.core.vars.generators.${networkGenerator}.files.prefix.value;
  controllerPublicKey =
    config.clan.core.vars.generators.${keysGenerator}.files.publickey.value;

  peerList = lib.mapAttrsToList (
    name: peer: {
      inherit name;
      inherit (peer) publicKey address persistentKeepalive;
    }
  ) cfg.peers;

  peersByName = lib.mapAttrs (name: peer: peer // { inherit name; }) cfg.peers;

  # A ready-to-import WireGuard client configuration per device. The private
  # key is deliberately NOT here — it lives on the device, and the user pastes
  # it in before importing the file.
  clientConf = peer: ''
    # FastFree mesh — device: ${peer.name}
    # Generated by modules/wireguard-peers.nix. Paste the device's private
    # key where marked, then import this file into the WireGuard app.
    [Interface]
    PrivateKey = <PASTE THE DEVICE PRIVATE KEY HERE>
    Address = ${peer.address}/56

    [Peer]
    PublicKey = ${controllerPublicKey}
    Endpoint = ${cfg.endpoint}:${toString cfg.port}
    AllowedIPs = ${controllerPrefix}::/56
    PersistentKeepalive = ${toString peer.persistentKeepalive}
  '';
in
{
  options.fastfree.wireguardPeers = {
    enable = lib.mkEnableOption "External (non-Clan) peers on the Clan WireGuard mesh";

    instance = lib.mkOption {
      type = lib.types.str;
      default = "wireguard";
      description = ''
        Name of the Clan wireguard service instance. Must match the instance
        in clan.nix: it is the WireGuard interface name and the vars prefix.
      '';
    };

    domain = lib.mkOption {
      type = lib.types.str;
      default = "wireguard";
      description = ''
        Hostname suffix for the devices, so they are reachable as
        `<peer name>.<domain>` (e.g. client1_d_1.wireguard).
      '';
    };

    endpoint = lib.mkOption {
      type = lib.types.str;
      default = "fastfree.cloud";
      description = ''
        Public endpoint the devices dial. Must be the controller's public
        endpoint — the same one the official service uses.
      '';
    };

    port = lib.mkOption {
      type = lib.types.port;
      default = 51821;
      description = "UDP port the devices dial. Must match the controller's port.";
    };

    peers = lib.mkOption {
      type = lib.types.attrsOf (
        lib.types.submodule (
          { name, ... }:
          {
            options = {
              publicKey = lib.mkOption {
                type = lib.types.str;
                description = ''
                  WireGuard public key of the device. Generate the keypair ON
                  THE DEVICE (`wg genkey | wg pubkey`) and copy only the public
                  key here — the private key never leaves the device.
                '';
              };

              address = lib.mkOption {
                type = lib.types.str;
                example = "fd28:387a:3f:4500:1917:e334:07c2:8366";
                description = ''
                  The device's address inside the controller's /56 subnet. It
                  must be unique across the mesh.

                  Use the helper to pick one:

                    python3 scripts/wg-peer-address.py client1_d_1

                  It prints an address derived exactly the way the official
                  service derives the Clan peers' addresses (sha256 of the
                  name), so external and internal peers look the same.
                '';
              };

              persistentKeepalive = lib.mkOption {
                type = lib.types.int;
                default = 25;
                description = ''
                  Seconds between keepalive packets. Matches the value the
                  official service uses for its own peers, and keeps the NAT
                  mapping alive on mobile networks.
                '';
              };
            };
          }
        )
      );
      default = { };
      description = ''
        External peers to admit to the mesh, keyed by `<client>_d_<n>`.

        Example:

          fastfree.wireguardPeers.peers.client1_d_1 = {
            publicKey = "h4Zo…=";
            address = "fd28:387a:3f:4500:8a1c:…";
          };
      '';
    };
  };

  config = lib.mkIf isController {
    # Appended to (never replaces) the peer list the official service builds.
    networking.wireguard.interfaces.${instance}.peers =
      map (peer: {
        inherit (peer) publicKey persistentKeepalive;
        allowedIPs = [ "${peer.address}/96" ];
      }) peerList;

    # Hostnames for the devices, so they can be reached by name from any
    # member of the mesh. The official service writes the same option for
    # the Clan peers; `types.lines` merges by concatenation, so both sets
    # end up in /etc/hosts. A string is used here, exactly like the service
    # does, so the merge behaves the same in both directions.
    networking.extraHosts = concatStringsSep "\n" (
      map (peer: "${peer.address} ${peer.name}.${domain}") peerList
    );

    # Ready-to-import client configuration, one file per device. The device's
    # private key is NOT in it — the user pastes it in before importing.
    environment.etc = lib.mapAttrs' (
      name: peer:
      lib.nameValuePair "fastfree/wireguard-peers/${name}.conf" {
        text = clientConf peer;
        mode = "0644";
      }
    ) peersByName;
  };
}
