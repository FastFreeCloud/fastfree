{ config, lib, pkgs, inputs ? {}, ... }:

let
  cfg = config.fastfree.panel.wireguard;
  backendDir = "/var/lib/fastfree-panel/backend";
  routeFile = "${backendDir}/src/routes/wireguard.ts";
  serverFile = "${backendDir}/src/server.ts";
  packageJson = "${backendDir}/package.json";

  # The TypeScript route implementation for WireGuard QR code endpoint
  # Using double single-quotes ('') for multi-line string, escaping $ as $$ for TypeScript template literals
  wireguardRouteTS = ''
    /**
     * GET /api/v1/wireguard/peers/:name/qr
     *
     * Returns WireGuard QR code for a peer.
     * Reads controller public key from clan vars and computes device address.
     * Supports Accept: image/png for direct image, otherwise returns base64 JSON.
     */

    import { Hono } from "hono";
    import { config } from "../config.js";
    import { runClan, argvFor } from "../clan/exec.js";
    import { ApiError } from "../http/errors.js";
    import { ok } from "../http/respond.js";
    import QRCode from "qrcode";

    export const wireguardRoutes = new Hono();

    interface WireGuardPeerQRResponse {
      peer: string;
      qrCodeBase64: string;
      config: string;
    }

    /**
     * Compute device address from peer name using SHA256 (matching official ipv6_allocator.py).
     * The official clan-core wireguard service derives addresses from the peer name.
     */
    async function computeDeviceAddress(peerName: string, controllerPrefix: string): Promise<string> {
      // Extract the /56 prefix (e.g., "fd28:387a:3f:4500::/56" -> "fd28:387a:3f:4500")
      const prefixMatch = controllerPrefix.match(/^([0-9a-f:]+):{0,2}\/\d+$/i);
      if (!prefixMatch) {
        throw new Error(`Invalid controller prefix format: $${controllerPrefix}`);
      }
      const prefixBase = prefixMatch[1].replace(/::?$/, "");

      // Compute SHA256 of peer name (matching official allocator)
      const crypto = await import("node:crypto");
      const hash = crypto.createHash("sha256").update(peerName).digest("hex");

      // Take first 16 hex chars (64 bits) for the interface identifier
      // Format as IPv6 hextets: split into 4 groups of 4 hex chars
      const suffix = hash.slice(0, 16).match(/.{1,4}/g)?.join(":") ?? "";

      // Combine prefix and suffix
      // The prefix is a /56, so we need to expand it to full IPv6
      // e.g., fd28:387a:3f:4500::/56 -> fd28:387a:3f:4500:xxxx:xxxx:xxxx:xxxx
      const prefixParts = prefixBase.split(":");
      // Pad prefix to 4 hextets (56 bits = 4 hextets)
      while (prefixParts.length < 4) {
        prefixParts.push("0000");
      }
      const fullPrefix = prefixParts.slice(0, 4).join(":");

      return `$${fullPrefix}:$${suffix}`;
    }

    /**
     * Read controller public key from clan vars.
     * Var path: clan.core.vars.generators."wireguard-keys-wireguard".files.publickey.value
     */
    async function getControllerPublicKey(): Promise<string> {
      if (!config.clanDir) {
        throw ApiError.notConfigured("Clan directory not configured on server.");
      }

      try {
        // Use clan vars get to read the public key
        const result = await runClan([
          "vars", "get",
          "clan.core.vars.generators.wireguard-keys-wireguard.files.publickey.value"
        ]);

        const publicKey = result.stdout.trim();
        if (!publicKey) {
          throw new Error("Empty public key from clan vars");
        }
        return publicKey;
      } catch (error) {
        if (error instanceof ApiError) throw error;
        throw ApiError.upstream("Failed to read controller WireGuard public key from clan vars.");
      }
    }

    /**
     * Read controller prefix (subnet) from clan vars.
     * Var path: clan.core.vars.generators."wireguard-network-wireguard".files.prefix.value
     */
    async function getControllerPrefix(): Promise<string> {
      if (!config.clanDir) {
        throw ApiError.notConfigured("Clan directory not configured on server.");
      }

      try {
        const result = await runClan([
          "vars", "get",
          "clan.core.vars.generators.wireguard-network-wireguard.files.prefix.value"
        ]);

        const prefix = result.stdout.trim();
        if (!prefix) {
          throw new Error("Empty prefix from clan vars");
        }
        return prefix;
      } catch (error) {
        if (error instanceof ApiError) throw error;
        throw ApiError.upstream("Failed to read controller WireGuard prefix from clan vars.");
      }
    }

    /**
     * Build WireGuard client configuration string (WITHOUT private key - placeholder).
     */
    function buildWireGuardConfig(
      peerName: string,
      deviceAddress: string,
      controllerPublicKey: string,
      endpoint: string,
      port: number,
      controllerPrefix: string,
      persistentKeepalive: number = 25
    ): string {
      return `# FastFree mesh -- device: $${peerName}
# Generated by FastFree Panel WireGuard QR endpoint.
# Paste the device'\''s private key where marked, then import into WireGuard app.
[Interface]
PrivateKey = <PASTE THE DEVICE PRIVATE KEY HERE>
Address = $${deviceAddress}/56

[Peer]
PublicKey = $${controllerPublicKey}
Endpoint = $${endpoint}:$${port}
AllowedIPs = $${controllerPrefix}
PersistentKeepalive = $${persistentKeepalive}
`;
    }

    /**
     * Validate peer name format: client{N}_d_{N}
     */
    function validatePeerName(name: string): boolean {
      // Matches: client1_d_1, client2_d_3, etc.
      return /^client\d+_d_\d+$/.test(name);
    }

    wireguardRoutes.get("/wireguard/peers/:name/qr", async (c) => {
      const peerName = c.req.param("name");
      const acceptHeader = c.req.header("Accept") || "";

      // Validate peer name format
      if (!validatePeerName(peerName)) {
        throw ApiError.validation("Invalid peer name format. Expected: client{N}_d_{N}", { field: "name" });
      }

      try {
        // Read controller public key and prefix from clan vars
        const [controllerPublicKey, controllerPrefix] = await Promise.all([
          getControllerPublicKey(),
          getControllerPrefix(),
        ]);

        // Compute device address
        const deviceAddress = await computeDeviceAddress(peerName, controllerPrefix);

        // Build WireGuard config (without private key)
        const endpoint = "fastfree.cloud"; // Controller public endpoint
        const port = 51821; // WireGuard mesh port
        const configString = buildWireGuardConfig(
          peerName,
          deviceAddress,
          controllerPublicKey,
          endpoint,
          port,
          controllerPrefix
        );

        // Generate QR code as PNG
        const qrCodeDataUrl = await QRCode.toDataURL(configString, {
          type: "image/png",
          errorCorrectionLevel: "M",
          margin: 1,
          width: 300,
        });

        // Extract base64 from data URL
        const base64 = qrCodeDataUrl.split(",")[1];

        // Check if client wants direct image
        const wantsImage = acceptHeader.includes("image/png");

        if (wantsImage) {
          // Return binary PNG
          const pngBuffer = Buffer.from(base64, "base64");
          return c.body(pngBuffer, 200, {
            "Content-Type": "image/png",
            "Content-Length": pngBuffer.length.toString(),
            "Cache-Control": "public, max-age=3600",
          });
        }

        // Return JSON with base64
        const response: WireGuardPeerQRResponse = {
          peer: peerName,
          qrCodeBase64: base64,
          config: configString,
        };

        return c.json(ok(response));
      } catch (error) {
        if (error instanceof ApiError) throw error;
        throw ApiError.upstream("Failed to generate WireGuard QR code.");
      }
    });
  '';

  # Patch script to inject the wireguard route into server.ts
  patchServerTS = ''
    #!/usr/bin/env bash
    set -euo pipefail

    SERVER_FILE="${1}"
    ROUTE_IMPORT="import { wireguardRoutes } from '\''./routes/wireguard.js'\'';"
    ROUTE_MOUNT="  app.route(API_PREFIX, wireguardRoutes);"

    if ! grep -q "wireguardRoutes" "${SERVER_FILE}"; then
      # Add import after other route imports
      sed -i "/import { herdrRoutes } from '\''\.\/routes\/herdr.js'\'';/a ${ROUTE_IMPORT}" "${SERVER_FILE}"

      # Add route mount after herdrRoutes mount
      sed -i "/app.route(API_PREFIX, herdrRoutes);/a ${ROUTE_MOUNT}" "${SERVER_FILE}"

      echo "[fastfree-panel-wg] Patched server.ts with wireguard route"
    else
      echo "[fastfree-panel-wg] server.ts already patched"
    fi
  '';

  # Patch script to add qrcode dependency to package.json
  patchPackageJSON = ''
    #!/usr/bin/env bash
    set -euo pipefail

    PKG_FILE="${1}"

    if ! grep -q '"qrcode"' "${PKG_FILE}"; then
      # Add qrcode dependency using jq
      jq '.dependencies.qrcode = "^1.5.3" | .devDependencies["@types/qrcode"] = "^1.5.5"' "${PKG_FILE}" > "${PKG_FILE}.tmp" && mv "${PKG_FILE}.tmp" "${PKG_FILE}"
      echo "[fastfree-panel-wg] Added qrcode to package.json"
    else
      echo "[fastfree-panel-wg] qrcode already in package.json"
    fi
  '';

in {
  options.fastfree.panel.wireguard = {
    enable = lib.mkEnableOption "WireGuard QR code endpoint for FastFree Panel";

    port = lib.mkOption {
      type = lib.types.port;
      default = 8080;
      description = "Panel backend port (for reference, actual backend runs on CLAN_PANEL_API_PORT).";
    };

    endpoint = lib.mkOption {
      type = lib.types.str;
      default = "fastfree.cloud";
      description = "Public WireGuard endpoint hostname.";
    };

    meshPort = lib.mkOption {
      type = lib.types.port;
      default = 51821;
      description = "WireGuard mesh UDP port.";
    };

    instance = lib.mkOption {
      type = lib.types.str;
      default = "wireguard";
      description = "Clan wireguard service instance name (for vars generator names).";
    };
  };

  config = lib.mkIf cfg.enable {
    # Ensure the route file exists in the backend source
    systemd.tmpfiles.rules = [
      "f ${routeFile} 0644 root root -"
    ];

    # Service to inject wireguard route into panel backend
    systemd.services."fastfree-panel-wg-inject" = {
      description = "Inject WireGuard QR route into FastFree Panel backend";
      before = [ "fastfree-panel.service" ];
      after = [ "fastfree-panel-setup.service" ];
      requires = [ "fastfree-panel-setup.service" ];
      type = "oneshot";
      path = with pkgs; [ bash coreutils jq nodejs_22 ];
      script = ''
        set -euo pipefail

        echo "[fastfree-panel-wg] Injecting WireGuard QR route..."

        # Write the route file
        cat > "${routeFile}" << "ROUTE_EOF"
${wireguardRouteTS}
ROUTE_EOF

        # Patch server.ts to import and mount the route
        ${patchServerTS} "${serverFile}"

        # Patch package.json to add qrcode dependency
        ${patchPackageJSON} "${packageJson}"

        # Reinstall dependencies if package.json changed
        if [ -f "${backendDir}/package.json" ]; then
          echo "[fastfree-panel-wg] Reinstalling backend dependencies..."
          cd "${backendDir}"
          ${pkgs.nodejs_22}/bin/npm install --omit=dev --legacy-peer-deps --no-audit --no-fund 2>&1 | tail -20
        fi

        echo "[fastfree-panel-wg] Injection complete"
      '';

    };

    # Ensure the inject service runs before panel
    systemd.services.fastfree-panel = lib.mkIf config.systemd.services.fastfree-panel {
      after = lib.mkForce (config.systemd.services.fastfree-panel.after or []) ++ [ "fastfree-panel-wg-inject.service" ];
      wants = lib.mkForce (config.systemd.services.fastfree-panel.wants or []) ++ [ "fastfree-panel-wg-inject.service" ];
    };

    # Ensure clan vars generators exist for wireguard
    assertions = lib.mkIf (config.clan.core.name == "client2") [
      {
        assertion = builtins.hasAttr "wireguard-keys-${cfg.instance}" config.clan.core.vars.generators;
        message = "Missing wireguard-keys-${cfg.instance} vars generator. Ensure clan.nix defines the wireguard instance with controller role on client2.";
      }
      {
        assertion = builtins.hasAttr "wireguard-network-${cfg.instance}" config.clan.core.vars.generators;
        message = "Missing wireguard-network-${cfg.instance} vars generator. Ensure clan.nix defines the wireguard instance with controller role on client2.";
      }
    ];
  };
}
