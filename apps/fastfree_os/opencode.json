{
  "$schema": "https://opencode.ai/config.json",
  "lsp": true,
  "mcp": {
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp"
    },
    "grep": {
      "type": "remote",
      "url": "https://mcp.grep.app"
    },
    "sequential-thinking": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@modelcontextprotocol/server-sequential-thinking"
      ]
    },
    "exa": {
      "type": "remote",
      "url": "https://mcp.exa.ai/mcp"
    },
    "midscene-web": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@midscene/web-bridge-mcp"
      ],
      "environment": {
        "MIDSCENE_MODEL_NAME": "gemini-3.1-flash",
        "MIDSCENE_MODEL_BASE_URL": "codex://app-server",
        "MIDSCENE_MODEL_FAMILY": "gemini",
        "MCP_SERVER_REQUEST_TIMEOUT": "600000"
      }
    },
    "playwright": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@playwright/mcp@latest",
        "--executable-path=C:\\Users\\FastFree\\AppData\\Local\\CentBrowser\\Application\\chrome.exe",
        "--user-data-dir=C:\\Users\\FastFree\\AppData\\Local\\CentBrowser\\User Data"
      ]
    },
    "firecrawl-mcp": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "firecrawl-mcp"
      ],
      "environment": {
        "FIRECRAWL_API_KEY": "fc-cb74dbc8adea45dc85a19a1e5c09fe94"
      }
    },
    "browsermcp": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@browsermcp/mcp@0.1.3"
      ],
      "enabled": true
    }
  },
  "permission": {
    "bash": {
      "*": "ask",
      "uv run flet *": "allow",
      "uv run python *": "allow",
      "bench *": "ask",
      "rm -rf *": "deny"
    }
  },
  "plugin": [
    "opencode-browser",
    "opencode-wakatime"

  ]
}
