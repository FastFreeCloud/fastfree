# FastFree Installer — Environment Variables
# Copy this file to .env and fill in the values

# License server authentication (required for license verification)
FASTFREE_API_SECRET_TOKEN=

# Master transfer secret (required for license transfers)
FASTFREE_MASTER_TRANSFER_SECRET=

# Hyper-V virtual switch name (optional, defaults to "FastFree-Switch")
FASTFREE_HYPERV_SWITCH=FastFree-Switch
