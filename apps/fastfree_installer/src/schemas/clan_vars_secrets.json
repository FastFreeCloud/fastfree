{
  "id": "clan_vars_secrets",
  "versionHash": "v2.2.0",
  "title": {
    "ar": "توليد الأسرار عبر clan vars generate",
    "en": "Secret Generation via clan vars generate"
  },
  "clan": {
    "spec": "clan.lol/schema/clan_vars_secrets",
    "module": "clan.core.vars.generators",
    "command": "clan vars generate",
    "generators": ["wireguard-private-key", "wireguard-preshared-key", "mariadb-root-password", "frappe-admin-password", "github-token", "backup-passphrase"]
  },
  "state": {
    "selectedNode": "client1",
    "revealed": false,
    "generatedAt": null,
    "secrets": {
      "wireguardPrivateKey": "gen:(wireguard-private-key)",
      "wireguardPsk": "gen:(wireguard-preshared-key)",
      "mariadbRoot": "gen:(mariadb-root-password)",
      "frappeAdmin": "gen:(frappe-admin-password)",
      "githubToken": "__NOT_SET__",
      "backupPassphrase": "gen:(backup-passphrase)"
    }
  },
  "root": {
    "type": "div",
    "class": "q-gutter-y-md",
    "children": [
      {
        "type": "banner",
        "class": "diag-card q-pa-md",
        "props": { "rounded": true, "dense": true },
        "children": [
          { "type": "icon", "props": { "name": "key", "size": "md", "color": "primary" } },
          {
            "type": "div",
            "class": "text-h6 text-weight-bold text-main",
            "text": { "ar": "توليد الأسرار — clan vars generate", "en": "Secret Generation — clan vars generate" }
          },
          {
            "type": "div",
            "class": "text-caption text-muted",
            "text": {
              "ar": "توليد أسرار العقدة {{ state.selectedNode || 'client1' }} مباشرة داخل بيئة النشر دون تخزين أي نص مكشوف",
              "en": "Generating {{ state.selectedNode || 'client1' }} secrets directly inside the deploy environment without storing plaintext"
            }
          }
        ]
      },
      {
        "type": "card",
        "class": "diag-card q-pa-md",
        "props": { "bordered": true },
        "children": [
          {
            "type": "div",
            "class": "text-caption accent-blue text-weight-bold q-mb-xs",
            "text": { "ar": "معيار حظر الأسرار المكشوفة (Clan Vars 26.05)", "en": "Zero Plaintext Secret Invariant (Clan Vars 26.05)" }
          },
          {
            "type": "div",
            "class": "text-body2 text-muted q-mb-md",
            "text": {
              "ar": "لا يتم تخزين المفاتيح الخاصة أو كلمات المرور في مستودع Git أو في أي ملف مكشوف، بل تُولّد عبر clan vars generate وتُحقن في النظام أثناء التثبيت فقط.",
              "en": "Private keys and passwords are never stored in Git or in plaintext files. They are generated with clan vars generate and injected into the system during installation only."
            }
          },
          {
            "type": "row",
            "class": "row items-center justify-between q-mb-md",
            "children": [
              {
                "type": "div",
                "class": "text-caption text-muted",
                "text": {
                  "ar": "حالة التوليد: {{ state.generatedAt || 'لم يتم التوليد بعد' }}",
                  "en": "Generation status: {{ state.generatedAt || 'not generated yet' }}"
                }
              },
              {
                "type": "button",
                "props": { "label": { "ar": "توليد جميع الأسرار", "en": "Generate All Secrets" }, "color": "primary", "icon": "vpn_key", "unelevated": true, "size": "sm" },
                "events": {
                  "click": [
                    { "type": "tauri:invoke", "command": "clan_vars_generate", "payload": { "node": "{{ state.selectedNode || 'client1' }}", "generators": ["wireguard-private-key", "wireguard-preshared-key", "mariadb-root-password", "frappe-admin-password", "backup-passphrase"] } },
                    { "type": "state:set", "target": "generatedAt", "payload": "ready" },
                    { "type": "notify", "payload": { "message": { "ar": "تم توليد أسرار العقدة بنجاح", "en": "Node secrets generated successfully" }, "color": "positive", "icon": "verified" } }
                  ]
                }
              }
            ]
          },
          {
            "type": "row",
            "class": "row q-col-gutter-md",
            "children": [
              {
                "type": "div",
                "class": "col-12 col-md-6",
                "children": [
                  {
                    "type": "card",
                    "class": "diag-card q-pa-sm",
                    "props": { "flat": true, "bordered": true },
                    "children": [
                      { "type": "icon", "props": { "name": "vpn_key", "color": "primary" } },
                      { "type": "div", "class": "text-subtitle2 text-weight-bold text-main", "text": { "ar": "المفتاح الخاص لـ WireGuard", "en": "WireGuard Private Key" } },
                      { "type": "div", "class": "text-caption text-muted q-mb-xs", "text": { "ar": "wireguard-private-key (سر)", "en": "wireguard-private-key (secret)" } },
                      { "type": "div", "class": "text-body2 text-main q-mb-xs", "text": { "ar": "{{ state.revealed ? state.secrets.wireguardPrivateKey : '••••••••••••••••' }}", "en": "{{ state.revealed ? state.secrets.wireguardPrivateKey : '••••••••••••••••' }}" } },
                      { "type": "button", "props": { "label": { "ar": "نسخ", "en": "Copy" }, "size": "sm", "outline": true, "color": "primary", "icon": "content_copy", "dense": true }, "events": { "click": { "type": "tauri:invoke", "command": "copy_to_clipboard", "payload": { "text": "{{ state.secrets.wireguardPrivateKey }}" } } } }
                    ]
                  }
                ]
              },
              {
                "type": "div",
                "class": "col-12 col-md-6",
                "children": [
                  {
                    "type": "card",
                    "class": "diag-card q-pa-sm",
                    "props": { "flat": true, "bordered": true },
                    "children": [
                      { "type": "icon", "props": { "name": "password", "color": "primary" } },
                      { "type": "div", "class": "text-subtitle2 text-weight-bold text-main", "text": { "ar": "المفتاح المشترك المسبق", "en": "WireGuard Pre-Shared Key" } },
                      { "type": "div", "class": "text-caption text-muted q-mb-xs", "text": { "ar": "wireguard-preshared-key (سر)", "en": "wireguard-preshared-key (secret)" } },
                      { "type": "div", "class": "text-body2 text-main q-mb-xs", "text": { "ar": "{{ state.revealed ? state.secrets.wireguardPsk : '••••••••••••••••' }}", "en": "{{ state.revealed ? state.secrets.wireguardPsk : '••••••••••••••••' }}" } },
                      { "type": "button", "props": { "label": { "ar": "نسخ", "en": "Copy" }, "size": "sm", "outline": true, "color": "primary", "icon": "content_copy", "dense": true }, "events": { "click": { "type": "tauri:invoke", "command": "copy_to_clipboard", "payload": { "text": "{{ state.secrets.wireguardPsk }}" } } } }
                    ]
                  }
                ]
              },
              {
                "type": "div",
                "class": "col-12 col-md-6",
                "children": [
                  {
                    "type": "card",
                    "class": "diag-card q-pa-sm",
                    "props": { "flat": true, "bordered": true },
                    "children": [
                      { "type": "icon", "props": { "name": "storage", "color": "primary" } },
                      { "type": "div", "class": "text-subtitle2 text-weight-bold text-main", "text": { "ar": "كلمة مرور MariaDB", "en": "MariaDB Root Password" } },
                      { "type": "div", "class": "text-caption text-muted q-mb-xs", "text": { "ar": "mariadb-root-password (سر)", "en": "mariadb-root-password (secret)" } },
                      { "type": "div", "class": "text-body2 text-main q-mb-xs", "text": { "ar": "{{ state.revealed ? state.secrets.mariadbRoot : '••••••••••••••••' }}", "en": "{{ state.revealed ? state.secrets.mariadbRoot : '••••••••••••••••' }}" } },
                      { "type": "button", "props": { "label": { "ar": "نسخ", "en": "Copy" }, "size": "sm", "outline": true, "color": "primary", "icon": "content_copy", "dense": true }, "events": { "click": { "type": "tauri:invoke", "command": "copy_to_clipboard", "payload": { "text": "{{ state.secrets.mariadbRoot }}" } } } }
                    ]
                  }
                ]
              },
              {
                "type": "div",
                "class": "col-12 col-md-6",
                "children": [
                  {
                    "type": "card",
                    "class": "diag-card q-pa-sm",
                    "props": { "flat": true, "bordered": true },
                    "children": [
                      { "type": "icon", "props": { "name": "admin_panel_settings", "color": "primary" } },
                      { "type": "div", "class": "text-subtitle2 text-weight-bold text-main", "text": { "ar": "كلمة مرور مدير Frappe", "en": "Frappe Admin Password" } },
                      { "type": "div", "class": "text-caption text-muted q-mb-xs", "text": { "ar": "frappe-admin-password (سر)", "en": "frappe-admin-password (secret)" } },
                      { "type": "div", "class": "text-body2 text-main q-mb-xs", "text": { "ar": "{{ state.revealed ? state.secrets.frappeAdmin : '••••••••••••••••' }}", "en": "{{ state.revealed ? state.secrets.frappeAdmin : '••••••••••••••••' }}" } },
                      { "type": "button", "props": { "label": { "ar": "نسخ", "en": "Copy" }, "size": "sm", "outline": true, "color": "primary", "icon": "content_copy", "dense": true }, "events": { "click": { "type": "tauri:invoke", "command": "copy_to_clipboard", "payload": { "text": "{{ state.secrets.frappeAdmin }}" } } } }
                    ]
                  }
                ]
              },
              {
                "type": "div",
                "class": "col-12 col-md-6",
                "children": [
                  {
                    "type": "card",
                    "class": "diag-card q-pa-sm",
                    "props": { "flat": true, "bordered": true },
                    "children": [
                      { "type": "icon", "props": { "name": "token", "color": "primary" } },
                      { "type": "div", "class": "text-subtitle2 text-weight-bold text-main", "text": { "ar": "رمز GitHub", "en": "GitHub Token" } },
                      { "type": "div", "class": "text-caption text-muted q-mb-xs", "text": { "ar": "github-token (تفعيل)", "en": "github-token (activation)" } },
                      { "type": "div", "class": "text-body2 text-main q-mb-xs", "text": { "ar": "{{ state.revealed ? state.secrets.githubToken : '••••••••••••••••' }}", "en": "{{ state.revealed ? state.secrets.githubToken : '••••••••••••••••' }}" } },
                      { "type": "button", "props": { "label": { "ar": "نسخ", "en": "Copy" }, "size": "sm", "outline": true, "color": "primary", "icon": "content_copy", "dense": true }, "events": { "click": { "type": "tauri:invoke", "command": "copy_to_clipboard", "payload": { "text": "{{ state.secrets.githubToken }}" } } } }
                    ]
                  }
                ]
              },
              {
                "type": "div",
                "class": "col-12 col-md-6",
                "children": [
                  {
                    "type": "card",
                    "class": "diag-card q-pa-sm",
                    "props": { "flat": true, "bordered": true },
                    "children": [
                      { "type": "icon", "props": { "name": "backup", "color": "primary" } },
                      { "type": "div", "class": "text-subtitle2 text-weight-bold text-main", "text": { "ar": "عبارة مرور النسخ الاحتياطي", "en": "Backup Passphrase" } },
                      { "type": "div", "class": "text-caption text-muted q-mb-xs", "text": { "ar": "backup-passphrase (سر)", "en": "backup-passphrase (secret)" } },
                      { "type": "div", "class": "text-body2 text-main q-mb-xs", "text": { "ar": "{{ state.revealed ? state.secrets.backupPassphrase : '••••••••••••••••' }}", "en": "{{ state.revealed ? state.secrets.backupPassphrase : '••••••••••••••••' }}" } },
                      { "type": "button", "props": { "label": { "ar": "نسخ", "en": "Copy" }, "size": "sm", "outline": true, "color": "primary", "icon": "content_copy", "dense": true }, "events": { "click": { "type": "tauri:invoke", "command": "copy_to_clipboard", "payload": { "text": "{{ state.secrets.backupPassphrase }}" } } } }
                    ]
                  }
                ]
              }
            ]
          },
          { "type": "separator", "props": { "class": "q-my-md" } },
          {
            "type": "row",
            "class": "row justify-between items-center",
            "children": [
              {
                "type": "button",
                "props": { "label": { "ar": "العودة لكتالوج الوحدات", "en": "Back to Modules Catalog" }, "color": "primary", "icon": "arrow_back", "outline": true },
                "events": { "click": { "type": "open_sdui_screen", "screen": "clan_modules_catalog" } }
              },
              {
                "type": "toggle",
                "model": "revealed",
                "props": { "label": { "ar": "إظهار قيم الأسرار", "en": "Reveal secret values" }, "color": "negative", "dense": true, "icon": "visibility" }
              },
              {
                "type": "button",
                "props": { "label": { "ar": "إعداد شبكة Mesh ←", "en": "Configure Mesh →" }, "color": "secondary", "iconRight": "arrow_forward", "unelevated": true },
                "events": { "click": { "type": "open_sdui_screen", "screen": "clan_mesh_wireguard" } }
              }
            ]
          }
        ]
      }
    ]
  }
}
