{
  "$schema": "https://raw.githubusercontent.com/tauri-apps/tauri/dev/crates/tauri-config-schema/schema.json",
  "productName": "FastFree-Node-Setup",
  "version": "26.5.0",
  "identifier": "cloud.fastfree.installer",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "FastFree Sovereign Node Installer",
        "width": 1060,
        "height": 700,
        "minWidth": 980,
        "minHeight": 650,
        "resizable": true,
        "center": true,
        "decorations": false,
        "visible": false
      },
      {
        "label": "splashscreen",
        "url": "splashscreen.html",
        "width": 480,
        "height": 320,
        "resizable": false,
        "center": true,
        "decorations": false,
        "transparent": true,
        "visible": true
      }
    ],
    "security": {
      "csp": "default-src 'self' 'unsafe-inline'; img-src 'self' data: https:;"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "certificateThumbprint": null,
      "digestAlgorithm": "sha256",
      "timestampUrl": "",
      "nsis": {
        "installMode": "perMachine",
        "languages": ["English", "Arabic"]
      }
    }
  },
  "plugins": {
    "updater": {
      "active": true,
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEMwQkUyRUZCQTM3MjBGOUYKUldTZkQzS2oreTYrd0V4cGRVdnZNbWNrSmlPSUZvZnBtakxGdkhvNDNRSnFJdUQ1YkdWaDZQM1YK",
      "endpoints": [
        "https://github.com/FastFreeCloud/fastfree/releases/latest/download/latest.json"
      ]
    }
  }
}
